{
  "compilerOptions": {
    "outDir": "./dist/",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "module": "CommonJS",
    "target": "ES2020",
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["chrome", "mocha"]
  },
  "include": ["src", "webpack.d.ts"],
  "exclude": ["src/**/*-test.ts", "src/**/*-test.js"],
  "ts-node": {
    "transpileOnly": true
  }
}
