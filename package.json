{
  "name": "popup-tab-switcher",
  "version": "1.0.0",
  "description": "A browser extension that makes switching between tabs more convenient.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvdvdmt/popup-tab-switcher.git"
  },
  "scripts": {
    "build:dev": "webpack build --env development",
    "build:prod": "ts-node ./scripts/build-prod.ts",
    "clean": "rm -rf build*",
    "lint": "eslint --ext .ts,.js ./",
    "start": "webpack watch --env development",
    "test": "mocha --require ts-node/register --bail ./src/**/*-test.{js,ts}",
    "test:ts": "tsc --noEmit"
  },
  "keywords": [
    "extension",
    "tabs",
    "switching"
  ],
  "author": "Dmitriy Davydov",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@material/ripple": "^2.3.0",
    "@types/chrome": "^0.0.235",
    "@types/mocha": "^7.0.1",
    "@typescript-eslint/eslint-plugin": "^2.20.0",
    "@typescript-eslint/parser": "^2.20.0",
    "@webcomponents/custom-elements": "^1.3.2",
    "babel-loader": "^9.1.2",
    "babel-preset-solid": "^1.6.10",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "deepmerge": "^3.3.0",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^13.2.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-mocha-no-only": "^1.1.0",
    "eslint-plugin-react": "^7.32.2",
    "mocha": "^10.2.0",
    "prettier": "^2.4.1",
    "sass": "^1.25.0",
    "sass-loader": "^13.0.1",
    "solid-js": "^1.6.10",
    "style-loader": "^3.3.2",
    "ts-node": "^8.6.2",
    "typescript": "^4.4.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
